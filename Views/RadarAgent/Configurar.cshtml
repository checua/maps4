@model RadarAgentConfigurationEditViewModel

@{
    ViewData["Title"] = "Configurar RADAR Agent";
    string? mensaje = TempData["RadarAgentConfiguracionMensaje"] as string;
    var seleccionados = Model.ChatsSeleccionados.ToHashSet(StringComparer.OrdinalIgnoreCase);
    var chatsOrdenados = Model.ChatsDisponibles
        .OrderByDescending(x => seleccionados.Contains(x.Nombre))
        .ThenBy(x => x.Nombre, StringComparer.CurrentCultureIgnoreCase)
        .ToList();
}

<div class="container py-4" style="max-width:820px;">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
        <div>
            <h2 class="mb-1">Configurar RADAR Agent</h2>
            <div class="text-muted">
                <strong>@Model.NombreAgent</strong>
                · @(string.IsNullOrWhiteSpace(Model.EquipoNombre) ? "Equipo no registrado" : Model.EquipoNombre)
            </div>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Volver a Agents</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert alert-success" role="alert">@mensaje</div>
    }

    @if (!Model.Activo)
    {
        <div class="alert alert-warning">
            Este Agent está revocado. La configuración se conserva para auditoría, pero ya no puede sincronizarla.
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <div class="mb-4">
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <span class="badge @(Model.Configurada ? "bg-success" : "bg-secondary")">
                        @(Model.Configurada ? "Configuración central activa" : "Todavía usa configuración local")
                    </span>
                    <span class="text-muted small font-monospace">@Model.IdAgent</span>
                </div>
                @if (Model.ActualizadoUtc.HasValue)
                {
                    <div class="text-muted small mt-2">
                        Última actualización: @Model.ActualizadoUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
                    </div>
                }
            </div>

            <form asp-action="GuardarConfiguracion" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="IdAgent" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Chats monitoreados</label>

                    @if (Model.ChatsDisponibles.Count > 0)
                    {
                        <div class="border rounded p-3 mb-3">
                            <div class="d-flex flex-column flex-md-row justify-content-between gap-2 mb-3">
                                <div>
                                    <div class="fw-semibold">Chats detectados en este equipo</div>
                                    <div class="text-muted small">
                                        Selecciona cuáles debe monitorear RADAR. RSMaps guarda únicamente el nombre del chat, no mensajes ni participantes.
                                    </div>
                                </div>
                                @if (Model.ChatsDetectadosUtc.HasValue)
                                {
                                    <div class="text-muted small text-md-end">
                                        Detectados: @Model.ChatsDetectadosUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
                                    </div>
                                }
                            </div>

                            <div class="row g-2 align-items-center mb-3">
                                <div class="col-12 col-md-7">
                                    <input id="radarChatSearch"
                                           type="search"
                                           class="form-control"
                                           autocomplete="off"
                                           placeholder="Buscar chat o grupo..." />
                                </div>
                                <div class="col-12 col-md-5">
                                    <div class="form-check">
                                        <input id="radarOnlySelected" class="form-check-input" type="checkbox" />
                                        <label class="form-check-label" for="radarOnlySelected">
                                            Mostrar solo seleccionados
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2 small text-muted">
                                <span>
                                    Seleccionados: <strong id="radarSelectedCount">@seleccionados.Count</strong>
                                </span>
                                <span>
                                    Mostrando <strong id="radarVisibleCount">@chatsOrdenados.Count</strong> de @chatsOrdenados.Count chats detectados
                                </span>
                            </div>

                            <div id="radarChatList" class="row g-2" style="max-height:440px; overflow-y:auto;">
                                @{ int chatIndex = 0; }
                                @foreach (var chat in chatsOrdenados)
                                {
                                    bool seleccionado = seleccionados.Contains(chat.Nombre);
                                    string idCheckbox = $"chat-{chatIndex++}";
                                    <div class="col-12 col-md-6 radar-chat-item"
                                         data-chat-name="@chat.Nombre.ToLowerInvariant()"
                                         data-selected="@(seleccionado ? "true" : "false")">
                                        <div class="form-check border rounded px-3 py-2 h-100" style="padding-left:2.25rem !important;">
                                            <input class="form-check-input radar-chat-checkbox"
                                                   type="checkbox"
                                                   name="ChatsSeleccionados"
                                                   value="@chat.Nombre"
                                                   id="@idCheckbox"
                                                   checked="@seleccionado" />
                                            <label class="form-check-label w-100" for="@idCheckbox">@chat.Nombre</label>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div id="radarNoChats" class="alert alert-light border py-2 small mt-3 mb-0 d-none">
                                No hay chats que coincidan con el filtro.
                            </div>
                        </div>

                        <label asp-for="ChatsTexto" class="form-label">Chats adicionales</label>
                        <textarea asp-for="ChatsTexto"
                                  class="form-control font-monospace"
                                  rows="3"
                                  placeholder="Opcional: agrega manualmente un chat por línea"></textarea>
                        <span asp-validation-for="ChatsTexto" class="text-danger small"></span>
                        <div class="form-text">
                            Usa este campo solo si un chat todavía no aparece entre los detectados.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border py-2 small mb-2">
                            Este Agent todavía no ha reportado chats disponibles. Puedes agregarlos manualmente por ahora.
                        </div>
                        <textarea asp-for="ChatsTexto"
                                  class="form-control font-monospace"
                                  rows="7"
                                  placeholder="Agrega un chat o grupo por línea"></textarea>
                        <span asp-validation-for="ChatsTexto" class="text-danger small"></span>
                        <div class="form-text">
                            Cuando el Agent reporte sus chats, aquí aparecerán como opciones seleccionables.
                        </div>
                    }
                </div>

                <div class="mb-4">
                    <label asp-for="DestinoAlertas" class="form-label fw-semibold">Destino de alertas</label>
                    <input asp-for="DestinoAlertas" class="form-control" maxlength="200" />
                    <div class="form-text">
                        Chat al que se enviarán las oportunidades cuando el modo seguro esté desactivado.
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="IntervaloRevisionMs" class="form-label fw-semibold">Intervalo de revisión</label>
                    <select asp-for="IntervaloRevisionMs" class="form-select">
                        <option value="10000">10 segundos</option>
                        <option value="30000">30 segundos</option>
                        <option value="60000">1 minuto</option>
                        <option value="300000">5 minutos</option>
                        <option value="1200000">20 minutos</option>
                    </select>
                    <span asp-validation-for="IntervaloRevisionMs" class="text-danger small"></span>
                </div>

                <div class="alert alert-light border small">
                    Durante la transición, si este Agent todavía no tiene configuración central guardada,
                    seguirá usando su JSON local. En cuanto guardes aquí, RSMaps se vuelve la fuente preferida
                    para chats, destino e intervalo. El modo SAFE LAB continúa imponiendo sus restricciones de seguridad.
                </div>

                @if (Model.Activo)
                {
                    <button type="submit" class="btn btn-primary">Guardar configuración</button>
                }
            </form>
        </div>
    </div>
</div>

@if (Model.ChatsDisponibles.Count > 0)
{
    <script>
        (() => {
            const search = document.getElementById('radarChatSearch');
            const onlySelected = document.getElementById('radarOnlySelected');
            const items = Array.from(document.querySelectorAll('.radar-chat-item'));
            const selectedCount = document.getElementById('radarSelectedCount');
            const visibleCount = document.getElementById('radarVisibleCount');
            const noChats = document.getElementById('radarNoChats');

            const normalize = value => (value || '').toLocaleLowerCase('es-MX').trim();

            const refreshCounts = () => {
                const selected = items.filter(item =>
                    item.querySelector('.radar-chat-checkbox')?.checked).length;
                selectedCount.textContent = selected.toString();
            };

            const applyFilter = () => {
                const query = normalize(search.value);
                const selectedOnly = onlySelected.checked;
                let visible = 0;

                for (const item of items) {
                    const checkbox = item.querySelector('.radar-chat-checkbox');
                    const matchesText = !query || normalize(item.dataset.chatName).includes(query);
                    const matchesSelected = !selectedOnly || !!checkbox?.checked;
                    const show = matchesText && matchesSelected;
                    item.classList.toggle('d-none', !show);
                    if (show) visible++;
                }

                visibleCount.textContent = visible.toString();
                noChats.classList.toggle('d-none', visible > 0);
                refreshCounts();
            };

            search.addEventListener('input', applyFilter);
            onlySelected.addEventListener('change', applyFilter);
            for (const checkbox of document.querySelectorAll('.radar-chat-checkbox')) {
                checkbox.addEventListener('change', applyFilter);
            }

            applyFilter();
        })();
    </script>
}
