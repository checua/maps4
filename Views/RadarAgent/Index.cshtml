@model RadarAgentPairingPageViewModel

@{
    ViewData["Title"] = "RADAR Agent";
}

<div class="container py-4" style="max-width:760px;">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h2 class="mb-2">Vincular RADAR Agent</h2>
            <p class="text-muted mb-4">
                Genera un código temporal para vincular este equipo con tu usuario y cuenta actuales de RSMaps.
                El código dura 10 minutos y solo puede utilizarse una vez.
            </p>

            <div class="mb-3">
                <strong>Cuenta:</strong>
                <span>@(string.IsNullOrWhiteSpace(Model.CuentaNombre) ? "Cuenta actual" : Model.CuentaNombre)</span>
            </div>

            <form asp-action="CrearCodigo" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="NombreAgent" class="form-label">Nombre del Agent</label>
                    <input asp-for="NombreAgent" class="form-control" maxlength="120" autocomplete="off" />
                    <div class="form-text">Ejemplo: Agent Che</div>
                </div>

                <button type="submit" class="btn btn-primary">Generar código de vinculación</button>
            </form>

            @if (!string.IsNullOrWhiteSpace(Model.Codigo))
            {
                <hr class="my-4" />
                <div class="alert alert-warning mb-3">
                    No compartas este código. Quien lo use podrá vincular un RADAR Agent a tu cuenta.
                </div>

                <div class="mb-2"><strong>Código:</strong></div>
                <div class="font-monospace fs-4 border rounded p-3 bg-light text-break">@Model.Codigo</div>

                @if (Model.ExpiraUtc.HasValue)
                {
                    <div class="text-muted mt-2">
                        Expira a las @Model.ExpiraUtc.Value.ToLocalTime().ToString("HH:mm:ss") hora local.
                    </div>
                }
            }
        </div>
    </div>
</div>
