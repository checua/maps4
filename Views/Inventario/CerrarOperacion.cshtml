@model maps4.Models.CerrarOperacionViewModel
@using System.Globalization
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Cerrar operación - RSMaps";
    var cultura = CultureInfo.GetCultureInfo("es-MX");
    var publicAssetBaseUrl = (Configuration["RSMaps:PublicAssetBaseUrl"] ?? string.Empty).TrimEnd('/');
    var fallbackImage = string.IsNullOrWhiteSpace(publicAssetBaseUrl)
        ? string.Empty
        : $"{publicAssetBaseUrl}/cargas/{Model.IdInmueble}_1.jpg";
}

<style>
    body { background:#f5f6f8; }
    .close-shell { max-width:900px; margin:0 auto; padding:28px 18px 48px; color:#17212b; }
    .close-top { display:flex; justify-content:space-between; gap:16px; align-items:flex-start; margin-bottom:20px; flex-wrap:wrap; }
    .close-top h1 { margin:0; font-size:30px; font-weight:760; }
    .close-top p { margin:5px 0 0; color:#667085; }
    .back-link { text-decoration:none; border:1px solid #d8dde5; background:white; color:#344054; border-radius:11px; padding:10px 14px; }
    .close-layout { display:grid; grid-template-columns:minmax(250px,.9fr) minmax(320px,1.35fr); gap:18px; }
    .panel { background:white; border:1px solid #e1e5ea; border-radius:18px; overflow:hidden; box-shadow:0 2px 8px rgba(16,24,40,.03); }
    .property-image { height:220px; background:#e9edf2; display:flex; align-items:center; justify-content:center; overflow:hidden; color:#7c8796; font-size:42px; }
    .property-image img { width:100%; height:100%; object-fit:cover; }
    .property-summary { padding:18px; }
    .property-summary h2 { margin:0 0 6px; font-size:20px; }
    .property-summary .price { font-size:24px; font-weight:760; margin:12px 0; }
    .muted { color:#667085; }
    .badges { display:flex; gap:7px; flex-wrap:wrap; margin-top:12px; }
    .badge-soft { border:1px solid #d8dde5; border-radius:999px; padding:5px 9px; font-size:11px; font-weight:700; background:#f8fafc; }
    .form-panel { padding:22px; }
    .form-panel h2 { margin:0 0 6px; font-size:22px; }
    .form-panel > p { color:#667085; margin:0 0 20px; }
    .field { margin-bottom:16px; }
    .field label { display:block; font-size:13px; font-weight:700; margin-bottom:6px; color:#344054; }
    .field input, .field select, .field textarea { width:100%; border:1px solid #d0d5dd; border-radius:10px; padding:10px 11px; background:#fff; min-height:44px; }
    .field textarea { min-height:105px; resize:vertical; }
    .validation { color:#b42318; font-size:12px; margin-top:5px; display:block; }
    .validation-summary { background:#fff2f0; color:#912018; border:1px solid #f1c8c3; border-radius:11px; padding:10px 12px; margin-bottom:16px; }
    .warning-box { background:#fff8e8; border:1px solid #f1ddb0; color:#7a4d00; border-radius:12px; padding:12px 14px; margin:18px 0; font-size:13px; line-height:1.5; }
    .actions { display:flex; justify-content:flex-end; gap:10px; flex-wrap:wrap; }
    .btn-secondary-rs { text-decoration:none; border:1px solid #d0d5dd; color:#344054; background:white; border-radius:10px; padding:10px 14px; }
    .btn-close-rs { border:0; background:#17212b; color:white; border-radius:10px; padding:10px 16px; font-weight:700; cursor:pointer; }
    @@media (max-width:760px) {
        .close-layout { grid-template-columns:1fr; }
        .close-top h1 { font-size:25px; }
        .property-image { height:190px; }
    }
</style>

<div class="close-shell">
    <div class="close-top">
        <div>
            <h1>Cerrar operación</h1>
            <p>Inmueble @Model.IdInmueble · registra el resultado real de la comercialización.</p>
        </div>
        <a class="back-link" asp-controller="Inventario" asp-action="Index">← Volver a Mi inventario</a>
    </div>

    <div class="close-layout">
        <section class="panel">
            <div class="property-image">
                @if (Model.Imagenes > 0)
                {
                    <img src="@($"/cargas/{Model.IdInmueble}_1.jpg")"
                         data-fallback-src="@fallbackImage"
                         alt="Inmueble @Model.IdInmueble"
                         onerror="handleCloseImageError(this)" />
                    <span class="image-placeholder" style="display:none;">⌂</span>
                }
                else
                {
                    <span>⌂</span>
                }
            </div>
            <div class="property-summary">
                <h2>@(string.IsNullOrWhiteSpace(Model.TipoNombre) ? $"Inmueble {Model.IdInmueble}" : Model.TipoNombre)</h2>
                <div class="muted">@(string.IsNullOrWhiteSpace(Model.Direccion) || Model.Direccion.Equals("Dirección", StringComparison.OrdinalIgnoreCase) ? "Ubicación registrada en mapa" : Model.Direccion)</div>
                @if (Model.PrecioPublicado.HasValue && Model.PrecioPublicado.Value > 0)
                {
                    <div class="price">@Model.PrecioPublicado.Value.ToString("C0", cultura)</div>
                    <div class="muted">Precio publicado actual</div>
                }
                else
                {
                    <div class="price">Precio publicado pendiente</div>
                }
                <div class="badges">
                    <span class="badge-soft">@Model.EstadoActual</span>
                    <span class="badge-soft">@Model.VisibilidadActual</span>
                </div>
            </div>
        </section>

        <section class="panel form-panel">
            <h2>Datos del cierre</h2>
            <p>Estos datos alimentarán el historial y la analítica de mercado de RSMaps.</p>

            <form id="closeOperationForm" asp-controller="Inventario" asp-action="CerrarOperacion" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="IdInmueble" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="field">
                    <label asp-for="TipoOperacion">¿Cómo se cerró?</label>
                    <select asp-for="TipoOperacion">
                        <option value="VENTA">Venta</option>
                        <option value="RENTA">Renta</option>
                    </select>
                    <span asp-validation-for="TipoOperacion" class="validation"></span>
                </div>

                <div class="field">
                    <label asp-for="PrecioCierre"></label>
                    <input asp-for="PrecioCierre" type="number" min="0.01" step="0.01" inputmode="decimal" placeholder="Ej. 3750000" />
                    <span asp-validation-for="PrecioCierre" class="validation"></span>
                </div>

                <div class="field">
                    <label asp-for="FechaCierre"></label>
                    <input asp-for="FechaCierre" type="date" max="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="FechaCierre" class="validation"></span>
                </div>

                <div class="field">
                    <label asp-for="NotasCierre"></label>
                    <textarea asp-for="NotasCierre" maxlength="1000" placeholder="Opcional: condiciones relevantes, negociación, observaciones del cierre..."></textarea>
                    <span asp-validation-for="NotasCierre" class="validation"></span>
                </div>

                <div class="warning-box">
                    <strong>Importante:</strong> al registrar el cierre, la propiedad cambiará a <strong>VENDIDO</strong> o <strong>RENTADO</strong>, dejará de aparecer en el marketplace público y se conservará como historial. Esta acción no se puede revertir desde Mi inventario.
                </div>

                <div class="actions">
                    <a class="btn-secondary-rs" asp-controller="Inventario" asp-action="Index">Cancelar</a>
                    <button class="btn-close-rs" type="submit">Registrar cierre</button>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
<script>
    function handleCloseImageError(img) {
        const fallback = img.dataset.fallbackSrc || '';
        if (fallback && img.dataset.fallbackTried !== 'true') {
            img.dataset.fallbackTried = 'true';
            img.src = fallback;
            return;
        }
        img.style.display = 'none';
        const placeholder = img.nextElementSibling;
        if (placeholder) placeholder.style.display = '';
    }

    (() => {
        const form = document.getElementById('closeOperationForm');
        if (!form || typeof Swal === 'undefined') return;

        form.addEventListener('submit', async (event) => {
            if (form.dataset.confirmed === 'true') return;
            event.preventDefault();

            const tipo = form.querySelector('[name="TipoOperacion"]')?.value === 'RENTA' ? 'renta' : 'venta';
            const result = await Swal.fire({
                title: `Confirmar ${tipo}`,
                text: 'Se registrará una operación real y la propiedad saldrá del marketplace público.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Sí, registrar cierre',
                cancelButtonText: 'Cancelar',
                reverseButtons: true
            });

            if (result.isConfirmed) {
                form.dataset.confirmed = 'true';
                form.requestSubmit();
            }
        });
    })();
</script>
}
