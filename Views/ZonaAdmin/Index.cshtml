@model maps4.Models.ZonaAdminIndexViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Administrador de zonas";
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    string inmueblesJson = JsonSerializer.Serialize(Model.Inmuebles, jsonOptions);
}

<style>
    body { background: #f5f7fb; }
    .zona-shell { min-height: 100vh; display: grid; grid-template-columns: 350px 1fr; }
    .zona-panel { background: #fff; border-right: 1px solid #e5e7eb; padding: 18px; overflow-y: auto; max-height: 100vh; }
    .zona-map-wrap { position: relative; min-height: 100vh; }
    #zona-map { position: absolute; inset: 0; }
    .zona-title { font-weight: 700; font-size: 1.35rem; margin-bottom: 2px; }
    .zona-subtitle { color: #6b7280; font-size: .9rem; margin-bottom: 16px; }
    .zona-actions { display: flex; gap: 8px; flex-wrap: wrap; margin: 12px 0; }
    .zona-card { border: 1px solid #e5e7eb; border-radius: 10px; padding: 10px 12px; margin-bottom: 8px; cursor: pointer; }
    .zona-card:hover { background: #f8fafc; }
    .zona-dot { width: 12px; height: 12px; border-radius: 999px; display: inline-block; margin-right: 8px; vertical-align: -1px; }
    .zona-help { background: #f8fafc; border-radius: 10px; padding: 10px 12px; font-size: .86rem; color: #475569; }
    .zona-status { position: absolute; top: 14px; left: 14px; z-index: 5; background: rgba(255,255,255,.96); border-radius: 10px; padding: 8px 12px; box-shadow: 0 4px 18px rgba(0,0,0,.12); font-size: .88rem; }
    .form-label { font-size: .84rem; font-weight: 600; margin-bottom: 4px; }
    @@media (max-width: 850px) {
        .zona-shell { grid-template-columns: 1fr; grid-template-rows: auto 68vh; }
        .zona-panel { max-height: none; border-right: 0; border-bottom: 1px solid #e5e7eb; }
        .zona-map-wrap { min-height: 68vh; }
    }
</style>

<div class="zona-shell">
    <aside class="zona-panel">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <div class="zona-title">Zonas RSMaps</div>
                <div class="zona-subtitle">Herramienta privada de administración</div>
            </div>
            <a href="/Inventario" class="btn btn-sm btn-outline-secondary">Inventario</a>
        </div>

        @Html.AntiForgeryToken()
        <input type="hidden" id="zona-id" />

        <div class="mb-2">
            <label class="form-label" for="zona-nombre">Nombre</label>
            <input id="zona-nombre" class="form-control" maxlength="120" placeholder="Ej. Mezquital" />
        </div>
        <div class="mb-2">
            <label class="form-label" for="zona-codigo">Código</label>
            <input id="zona-codigo" class="form-control" maxlength="60" placeholder="MEZQUITAL" />
        </div>
        <div class="row g-2 mb-2">
            <div class="col-7">
                <label class="form-label" for="zona-prioridad">Prioridad</label>
                <input id="zona-prioridad" class="form-control" type="number" min="0" max="10000" value="100" />
            </div>
            <div class="col-5">
                <label class="form-label" for="zona-color">Color</label>
                <input id="zona-color" class="form-control form-control-color w-100" type="color" value="#ef4444" />
            </div>
        </div>
        <div class="mb-2">
            <label class="form-label" for="zona-descripcion">Descripción</label>
            <textarea id="zona-descripcion" class="form-control" rows="2" maxlength="500" placeholder="Opcional"></textarea>
        </div>

        <div class="zona-actions">
            <button id="btn-zona-nueva" type="button" class="btn btn-outline-primary btn-sm">Nueva</button>
            <button id="btn-zona-dibujar" type="button" class="btn btn-primary btn-sm">Dibujar</button>
            <button id="btn-zona-deshacer" type="button" class="btn btn-outline-secondary btn-sm">Deshacer vértice</button>
            <button id="btn-zona-limpiar" type="button" class="btn btn-outline-danger btn-sm">Limpiar</button>
            <button id="btn-zona-guardar" type="button" class="btn btn-success btn-sm">Guardar zona</button>
        </div>

        <div class="zona-help mb-3">
            Pulsa <strong>Dibujar</strong> y haz clic alrededor del área. Desde el tercer punto aparecerá el polígono. Después puedes mover sus vértices directamente en el mapa antes de guardar.
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <strong>Zonas existentes</strong>
            <span class="badge bg-secondary">@Model.Zonas.Count</span>
        </div>

        <div id="zona-lista">
            @foreach (var zona in Model.Zonas)
            {
                <div class="zona-card" data-id-zona="@zona.IdZona">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="zona-dot" style="background:@(zona.ColorHex ?? "#ef4444")"></span>
                            <strong>@zona.Nombre</strong>
                        </div>
                        <small class="text-muted">@zona.Inmuebles inm.</small>
                    </div>
                    <div class="small text-muted mt-1">@zona.Codigo · prioridad @zona.Prioridad · @zona.Poligonos polígono(s)</div>
                </div>
            }
        </div>
    </aside>

    <main class="zona-map-wrap">
        <div id="zona-status" class="zona-status">Cargando mapa…</div>
        <div id="zona-map"></div>
    </main>
</div>

<script>
    window.rsMapsZonaPins = @Html.Raw(inmueblesJson);
</script>

@section Scripts {
    <script src="~/js/zona-admin.js" asp-append-version="true"></script>
}
